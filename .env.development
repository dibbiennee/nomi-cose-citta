# Solo per npm start: emulatore Firebase locale, progetto finto. Le chiavi vere sono in .env.production.
REACT_APP_EMULATOR=1
REACT_APP_FIREBASE_API_KEY=demo
REACT_APP_FIREBASE_AUTH_DOMAIN=demo-ncc.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=http://127.0.0.1:9100?ns=demo-ncc-default-rtdb
REACT_APP_FIREBASE_PROJECT_ID=demo-ncc
REACT_APP_FIREBASE_APP_ID=demo
BROWSER=none
