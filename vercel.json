{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://nomi-cose-citta-416e9.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/r/:code",
      "destination": "/index.html"
    },
    {
      "source": "/statistiche",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/condizioni-acquisto",
      "destination": "/condizioni-acquisto.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nomi-cose-citta-wine.vercel.app"
        }
      ],
      "destination": "https://nomicosecitta.pro/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.nomicosecitta.pro"
        }
      ],
      "destination": "https://nomicosecitta.pro/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/giudica.mjs": {
      "maxDuration": 30
    }
  }
}
