{
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/index.html"
    },
    {
      "source": "/statistiche",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nomi-cose-citta-wine.vercel.app"
        }
      ],
      "destination": "https://nomicosecitta.pro/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.nomicosecitta.pro"
        }
      ],
      "destination": "https://nomicosecitta.pro/:path*",
      "permanent": true
    }
  ]
}
